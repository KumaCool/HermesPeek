# Copy to ~/.config/hermes-peek/hermes-peek.env and restrict permissions to 0600.
# Do not commit real paths, IDs, URLs, or tokens.
HERMES_PEEK_ALLOWED_ROOTS=/path/to/approved/workspace
HERMES_PEEK_STATE_DIR=/absolute/path/to/.local/state/hermes-peek
HERMES_PEEK_EXTERNAL_BASE_URL=https://preview.example.invalid/
HERMES_PEEK_TELEGRAM_BOT_TOKEN=[REDACTED]
HERMES_PEEK_DEVELOPMENT=false
